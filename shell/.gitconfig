[user]
	name = mehm8128
	email = mehm8128@gmail.com
[core]
	editor = nvim
  sshCommand = ssh.exe
[alias]
  pushf = push --force-with-lease --force-if-includes
  com = commit -m
  co = checkout
  cob = checkout -b
  sl = stash list
[init]
	defaultBranch = main
[rebase]
	autostash = true
[rerere]
	enabled = true
