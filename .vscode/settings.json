{
  "workbench.colorTheme": "Material Theme High Contrast",
  "terminal.integrated.tabs.enabled": true,
  "security.workspace.trust.untrustedFiles": "open",
  "editor.formatOnType": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "javascript.updateImportsOnFileMove.enabled": "always",
  "explorer.confirmDragAndDrop": false,
  "editor.tabSize": 2,
  "git.confirmSync": false,
  "files.exclude": {
    "**/.git": false
  },
  "editor.suggestSelection": "first",
  "vsintellicode.modify.editor.suggestSelection": "automaticallyOverrodeDefaultValue",
  "editor.inlineSuggest.enabled": true,
  "github.copilot.enable": {
    "*": true,
    "yaml": true,
    "markdown": true,
    "typescriptreact": true,
    "javascript": true,
    "typescript": true,
    "javascriptreact": true,
    "postcss": true
  },
  "editor.acceptSuggestionOnEnter": "off",
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "editor.codeActionsOnSave": {
    "source.addMissingImports": "explicit",
    "quickfix.biome": "explicit",
    "source.organizeImports.biome": "explicit"
  },
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },
  "files.trimTrailingWhitespace": true,
  "typescript.preferences.importModuleSpecifier": "non-relative",
  "javascript.preferences.importModuleSpecifier": "non-relative",
  "editor.stickyScroll.enabled": true,
  "editor.stickyScroll.maxLineCount": 3,
  "workbench.colorCustomizations": {
    "editorStickyScroll.background": "#332765",
    "editorStickyScrollHover.background": "#504083",
    "[Material Theme High Contrast]": {}
  },
  "gitlens.hovers.currentLine.over": "line",
  "editor.guides.bracketPairs": false,
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "files.trimTrailingWhitespace": false
  },
  "powermode.combo.timerEnabled": "hide",
  "powermode.shake.enabled": false,
  "powermode.combo.timeout": 2,
  "powermode.combo.location": "off",
  "powermode.combo.counterEnabled": "hide",
  "powermode.explosions.size": 12,
  "powermode.enabled": true,
  "editor.inlayHints.enabled": "off",
  "editor.wordWrap": "off",
  "diffEditor.wordWrap": "off",
  "zenMode.hideActivityBar": false,
  "typescript.referencesCodeLens.enabled": true,
  "editor.glyphMargin": false,
  "workbench.tree.indent": 12,
  "explorer.compactFolders": false,
  "terminal.integrated.fontFamily": "\"DejaVuSansM Nerd Font Mono\"",
  "window.commandCenter": false,
  "background.fullscreen": {
    "images": ["https://example.com"],
    "opacity": 0.9,
    "size": "cover",
    "position": "center",
    "interval": 0
  },
  "background.enabled": false,
  "files.insertFinalNewline": true,
  "gitlens.rebaseEditor.ordering": "asc",
  "workbench.activityBar.location": "top",
  "git.enableSmartCommit": true,
  "editor.minimap.enabled": false,
  "update.showReleaseNotes": false,
  "explorer.confirmDelete": false,
  "gitlens.launchpad.indicator.enabled": false,
  "glassit.alpha": 240,
  "workbench.editor.customLabels.patterns": {
    "**/index.*": "${dirname} .../${dirname(1)}",
    "**/{page,route}.{js,ts,jsx,tsx}": "${dirname}/${filename}.${extname} .../${dirname(1)}"
  },
  "editor.tokenColorCustomizations": {
    "comments": "#9daeb1"
  },
  "window.zoomLevel": 1.3,
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.accessibilitySupport": "off",
  "workbench.startupEditor": "none",
  "githubPullRequests.pullBranch": "never",
  "editor.inlineSuggest.syntaxHighlightingEnabled": false,
  "terminal.integrated.env.linux": {},
  "cSpell.userWords": ["mehm", "wcag"],
  "githubPullRequests.commentExpandState": "collapseAll",
  "githubPullRequests.createOnPublishBranch": "never",
  "accessibility.signals.lineHasBreakpoint": {
    "sound": "off",
    "announcement": "auto"
  },
  "accessibility.signals.chatEditModifiedFile": {
    "sound": "off"
  },
  "accessibility.signals.chatRequestSent": {
    "sound": "off",
    "announcement": "auto"
  },
  "accessibility.signals.chatResponseReceived": {
    "sound": "off"
  },
  "accessibility.signals.clear": {
    "sound": "off",
    "announcement": "auto"
  },
  "accessibility.signals.codeActionApplied": {
    "sound": "off"
  },
  "accessibility.signals.codeActionTriggered": {
    "sound": "off"
  },
  "accessibility.signals.onDebugBreak": {
    "sound": "off",
    "announcement": "auto"
  },
  "accessibility.signals.diffLineDeleted": {
    "sound": "off"
  },
  "accessibility.signals.diffLineInserted": {
    "sound": "off"
  },
  "accessibility.signals.diffLineModified": {
    "sound": "off"
  },
  "accessibility.signals.editsKept": {
    "sound": "off",
    "announcement": "auto"
  },
  "accessibility.signals.positionHasError": {
    "sound": "off",
    "announcement": "auto"
  },
  "accessibility.signals.lineHasError": {
    "sound": "off",
    "announcement": "auto"
  },
  "accessibility.signals.lineHasFoldedArea": {
    "sound": "off",
    "announcement": "auto"
  },
  "accessibility.signals.lineHasInlineSuggestion": {
    "sound": "off"
  },
  "accessibility.signals.nextEditSuggestion": {
    "sound": "off",
    "announcement": "auto"
  },
  "accessibility.signals.noInlayHints": {
    "sound": "off",
    "announcement": "auto"
  },
  "accessibility.signals.notebookCellCompleted": {
    "sound": "off",
    "announcement": "auto"
  },
  "workbench.sideBar.location": "right"
}
